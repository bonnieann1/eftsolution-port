# Build output is regenerated by build.py on every deploy.
# dist/ is committed deliberately so a drag-and-drop deploy is always possible
# without running the build first. preview/ is local convenience only.
preview/

.DS_Store
node_modules/
__pycache__/
*.pyc

# Never commit anything from the Manus export's .project-config.json —
# it carries a live JWT secret and API keys. The file is deleted, not ignored,
# but this catches an accidental re-import.
.project-config.json
.env
.env.*
